{
  "name": "desk-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:auth": "node auth-service/src/server.js",
    "start:reservation": "node reservation-service/src/server.js",
    "start:activity": "node activity-service/src/server.js",
    "dev:auth": "node --watch auth-service/src/server.js",
    "dev:reservation": "node --watch reservation-service/src/server.js",
    "dev:activity": "node --watch activity-service/src/server.js",
    "start:all": "concurrently -n auth,reservation,activity -c blue,green,yellow \"npm run start:auth\" \"npm run start:reservation\" \"npm run start:activity\"",
    "test": "node --test auth-service/tests/auth.test.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
